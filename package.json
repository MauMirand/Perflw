{
  "name": "perflw",
  "productName": "Perflw",
  "version": "0.1.0",
  "private": true,
  "description": "Perflw: an offline-first desktop planner with learning, chat and AI automation",
  "license": "MIT",
  "author": "2Pyrox",
  "repository": {
    "type": "git",
    "url": "https://github.com/2Pyrox/Perflw.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
