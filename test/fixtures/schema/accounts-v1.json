    {
      "type": "table",
      "name": "sessions",
      "tbl_name": "sessions",
      "sql": "CREATE TABLE sessions (\n      token_hash TEXT PRIMARY KEY, user_id TEXT NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n      expires_at INTEGER NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "users",
      "tbl_name": "users",
      "sql": "CREATE TABLE users (\n      id TEXT PRIMARY KEY, email TEXT NOT NULL UNIQUE, password_hash TEXT NOT NULL,\n      display_name TEXT, bio TEXT, image_name TEXT,\n      cover_image_name TEXT,\n      cover_theme TEXT NOT NULL DEFAULT 'aurora' CHECK(cover_theme IN ('aurora','dusk','tide','ember')),\n      cover_position TEXT NOT NULL DEFAULT 'center 52%' CHECK(cover_position IN ('center 20%','center 52%','center 85%')),\n      profile_completed INTEGER NOT NULL DEFAULT 0,\n      failed_attempts INTEGER NOT NULL DEFAULT 0, locked_until INTEGER NOT NULL DEFAULT 0\n    )"
    }
