      "type": "table",
      "name": "active_timers",
      "tbl_name": "active_timers",
      "sql": "CREATE TABLE active_timers (\n      user_id TEXT PRIMARY KEY, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      task_id TEXT REFERENCES tasks(id) ON DELETE SET NULL, description TEXT NOT NULL, note TEXT NOT NULL DEFAULT '', skill TEXT NOT NULL DEFAULT '',\n      started_at TEXT NOT NULL, segment_started_at TEXT, elapsed_seconds INTEGER NOT NULL DEFAULT 0,\n      paused INTEGER NOT NULL DEFAULT 0\n    )"
    },
    {
      "type": "table",
      "name": "agents",
      "tbl_name": "agents",
      "sql": "CREATE TABLE agents (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL, description TEXT NOT NULL DEFAULT '',\n      instructions TEXT NOT NULL DEFAULT '', model TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "chat_defaults",
      "tbl_name": "chat_defaults",
      "sql": "CREATE TABLE chat_defaults (user_id TEXT PRIMARY KEY, settings_json TEXT NOT NULL, updated_at TEXT NOT NULL)"
    },
    {
      "type": "table",
      "name": "chat_memory",
      "tbl_name": "chat_memory",
      "sql": "CREATE TABLE chat_memory (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, text TEXT NOT NULL, created_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "chat_messages",
      "tbl_name": "chat_messages",
      "sql": "CREATE TABLE chat_messages (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, chat_id TEXT NOT NULL REFERENCES chat_sessions(id) ON DELETE CASCADE,\n      role TEXT NOT NULL CHECK(role IN ('user','assistant','system')), content TEXT NOT NULL, created_at TEXT NOT NULL\n    , meta_json TEXT)"
    },
    {
      "type": "table",
      "name": "chat_sessions",
      "tbl_name": "chat_sessions",
      "sql": "CREATE TABLE chat_sessions (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, title TEXT NOT NULL,\n      archived_at TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    , category TEXT NOT NULL DEFAULT 'work', settings_json TEXT NOT NULL DEFAULT '{}')"
    },
    {
      "type": "table",
      "name": "documents",
      "tbl_name": "documents",
      "sql": "CREATE TABLE documents (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, title TEXT NOT NULL, content TEXT NOT NULL DEFAULT '',\n      position INTEGER NOT NULL DEFAULT 0, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "events",
      "tbl_name": "events",
      "sql": "CREATE TABLE events (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      title TEXT NOT NULL, starts_at TEXT NOT NULL, ends_at TEXT,\n      theme TEXT NOT NULL DEFAULT 'light-blue',\n      task_id TEXT REFERENCES tasks(id) ON DELETE SET NULL\n    , image_name TEXT, event_type TEXT NOT NULL DEFAULT 'Schedule', location TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '')"
    },
    {
      "type": "table",
      "name": "finance_accounts",
      "tbl_name": "finance_accounts",
      "sql": "CREATE TABLE finance_accounts (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL, type TEXT NOT NULL CHECK(type IN ('cash','bank','ewallet','other')),\n      currency TEXT NOT NULL DEFAULT 'PHP' CHECK(currency='PHP'), opening_balance_minor INTEGER NOT NULL DEFAULT 0,\n      archived_at TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "finance_categories",
      "tbl_name": "finance_categories",
      "sql": "CREATE TABLE finance_categories (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('income','expense')),\n      archived_at TEXT, created_at TEXT NOT NULL, UNIQUE(user_id,name,kind)\n    )"
    },
    {
      "type": "table",
      "name": "finance_transactions",
      "tbl_name": "finance_transactions",
      "sql": "CREATE TABLE finance_transactions (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('income','expense','transfer')),\n      date TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK(amount_minor > 0), description TEXT NOT NULL,\n      category_id TEXT REFERENCES finance_categories(id) ON DELETE SET NULL,\n      account_id TEXT REFERENCES finance_accounts(id) ON DELETE RESTRICT,\n      source_account_id TEXT REFERENCES finance_accounts(id) ON DELETE RESTRICT,\n      destination_account_id TEXT REFERENCES finance_accounts(id) ON DELETE RESTRICT,\n      note TEXT NOT NULL DEFAULT '', created_at TEXT NOT NULL, updated_at TEXT NOT NULL,\n      CHECK((kind='transfer' AND account_id IS NULL AND source_account_id IS NOT NULL AND destination_account_id IS NOT NULL AND source_account_id<>destination_account_id AND category_id IS NULL)\n        OR (kind IN ('income','expense') AND account_id IS NOT NULL AND source_account_id IS NULL AND destination_account_id IS NULL))\n    )"
    },
    {
      "type": "table",
      "name": "focus_entries",
      "tbl_name": "focus_entries",
      "sql": "CREATE TABLE focus_entries (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      task_id TEXT REFERENCES tasks(id) ON DELETE SET NULL, description TEXT NOT NULL DEFAULT 'Focus session',\n      note TEXT NOT NULL DEFAULT '', skill TEXT NOT NULL DEFAULT '', source TEXT NOT NULL DEFAULT 'manual',\n      started_at TEXT NOT NULL, ended_at TEXT NOT NULL, duration_seconds INTEGER NOT NULL CHECK(duration_seconds > 0)\n    )"
    },
    {
      "type": "table",
      "name": "goals",
      "tbl_name": "goals",
      "sql": "CREATE TABLE goals (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      title TEXT NOT NULL, due_at TEXT, completed_at TEXT, created_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "ledger_entries",
      "tbl_name": "ledger_entries",
      "sql": "CREATE TABLE ledger_entries (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, kind TEXT NOT NULL CHECK(kind IN ('income','expense')),\n      category TEXT NOT NULL, amount_minor INTEGER NOT NULL CHECK(amount_minor > 0),\n      currency TEXT NOT NULL CHECK(length(currency) = 3), occurred_at TEXT NOT NULL, note TEXT NOT NULL DEFAULT ''\n    )"
    },
    {
      "type": "table",
      "name": "milestones",
      "tbl_name": "milestones",
      "sql": "CREATE TABLE milestones (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      title TEXT NOT NULL, due_at TEXT NOT NULL, completed_at TEXT\n    )"
    },
    {
      "type": "table",
      "name": "planner_items",
      "tbl_name": "planner_items",
      "sql": "CREATE TABLE planner_items (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL,\n      kind TEXT NOT NULL CHECK(kind IN ('plan','whim','routine','activity','learning')),\n      text TEXT NOT NULL, day TEXT, time TEXT, done_on TEXT, position INTEGER NOT NULL DEFAULT 0,\n      created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "project_blocks",
      "tbl_name": "project_blocks",
      "sql": "CREATE TABLE project_blocks (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,\n      type TEXT NOT NULL, text TEXT NOT NULL DEFAULT '', data TEXT NOT NULL DEFAULT '{}', position INTEGER NOT NULL DEFAULT 0,\n      created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "projects",
      "tbl_name": "projects",
      "sql": "CREATE TABLE projects (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, name TEXT NOT NULL,\n      created_at TEXT NOT NULL, description TEXT NOT NULL DEFAULT '', notes TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'active',\n      target_date TEXT, color TEXT NOT NULL DEFAULT '#8b5cf6', archived_at TEXT, updated_at TEXT NOT NULL DEFAULT ''\n    , cover TEXT, cover_pos INTEGER NOT NULL DEFAULT 50, icon TEXT NOT NULL DEFAULT '')"
    },
    {
      "type": "table",
      "name": "provider_connections",
      "tbl_name": "provider_connections",
      "sql": "CREATE TABLE provider_connections (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, type TEXT NOT NULL, label TEXT NOT NULL,\n      base_url TEXT NOT NULL DEFAULT '', model TEXT NOT NULL DEFAULT '', context_window INTEGER,\n      supports_tools INTEGER NOT NULL DEFAULT 0, secret BLOB, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "subject_files",
      "tbl_name": "subject_files",
      "sql": "CREATE TABLE subject_files (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, subject_id TEXT NOT NULL REFERENCES subjects(id) ON DELETE CASCADE,\n      name TEXT NOT NULL, stored_name TEXT NOT NULL, type TEXT NOT NULL, size INTEGER NOT NULL, text TEXT NOT NULL DEFAULT '',\n      created_at TEXT NOT NULL\n    , preview_name TEXT, preview_status TEXT NOT NULL DEFAULT 'none')"
    },
    {
      "type": "table",
      "name": "subject_topics",
      "tbl_name": "subject_topics",
      "sql": "CREATE TABLE subject_topics (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, subject_id TEXT NOT NULL REFERENCES subjects(id) ON DELETE CASCADE,\n      kind TEXT NOT NULL DEFAULT 'topic' CHECK (kind IN ('topic','milestone')), level INTEGER NOT NULL DEFAULT 0 CHECK (level IN (0,1)),\n      title TEXT NOT NULL, file_id TEXT REFERENCES subject_files(id) ON DELETE SET NULL, position INTEGER NOT NULL DEFAULT 0,\n      created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    , page INTEGER)"
    },
    {
      "type": "table",
      "name": "subjects",
      "tbl_name": "subjects",
      "sql": "CREATE TABLE subjects (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, profile TEXT NOT NULL CHECK (profile IN ('study','personal')),\n      name TEXT NOT NULL, type TEXT NOT NULL DEFAULT 'major' CHECK (type IN ('major','minor')),\n      mastery INTEGER NOT NULL DEFAULT 0 CHECK (mastery BETWEEN 0 AND 100), minutes INTEGER NOT NULL DEFAULT 0 CHECK (minutes >= 0),\n      description TEXT NOT NULL DEFAULT '', image_name TEXT, position INTEGER NOT NULL DEFAULT 0,\n      created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    },
    {
      "type": "table",
      "name": "tasks",
      "tbl_name": "tasks",
      "sql": "CREATE TABLE tasks (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, project_id TEXT REFERENCES projects(id) ON DELETE SET NULL,\n      goal_id TEXT REFERENCES goals(id) ON DELETE SET NULL, title TEXT NOT NULL,\n      due_at TEXT, completed_at TEXT, created_at TEXT NOT NULL, priority TEXT NOT NULL DEFAULT 'normal', skill TEXT NOT NULL DEFAULT ''\n    , image_name TEXT, skills_json TEXT NOT NULL DEFAULT '[]', icon TEXT NOT NULL DEFAULT '☑', theme TEXT NOT NULL DEFAULT 'blue', notes TEXT NOT NULL DEFAULT '')"
    },
    {
      "type": "table",
      "name": "workflows",
      "tbl_name": "workflows",
      "sql": "CREATE TABLE workflows (\n      id TEXT PRIMARY KEY, user_id TEXT NOT NULL, title TEXT NOT NULL, description TEXT NOT NULL DEFAULT '',\n      graph_json TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n    )"
    }
